[Unit]
Description=Fade unfocused windows and blur the wallpaper when covered
Documentation=man:xprop(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/focus-opacity
ExecStopPost=%h/.local/bin/focus-opacity --restore
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
